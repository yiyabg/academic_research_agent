# academic_research_agent Environment Variables

# === Project ===
PROJECT_NAME=academic_research_agent
DEBUG=true
DB_ECHO=false  # Set to true to log SQL queries
ENVIRONMENT=local
TIMEZONE=Asia/Shanghai  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache

# === Logfire ===
# Get your token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=academic_research_agent
LOGFIRE_ENVIRONMENT=development


# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host-side Docker port; change when another PostgreSQL already owns 5432.
POSTGRES_EXPOSE_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=academic_research_agent

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_EXPOSE_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# === RAG Configuration ===
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_CHUNKING_STRATEGY=recursive  # recursive, markdown, or fixed
RAG_HYBRID_SEARCH=false  # Enable BM25 + vector hybrid search
RAG_ENABLE_OCR=false  # OCR fallback for scanned PDFs (requires tesseract-ocr installed)
# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTP_EXPOSE_PORT=6333
QDRANT_GRPC_EXPOSE_PORT=6334
QDRANT_API_KEY=
# Reranker
HF_TOKEN=
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Dedicated local-paper BGE services can select CUDA independently from the
# general API/worker containers. The research compose overlay enforces CUDA.
LOCAL_PAPER_EMBEDDING_DEVICE=auto
LOCAL_PAPER_RERANKER_DEVICE=auto
LOCAL_PAPER_REQUIRE_CUDA=false
# === PDF Parser Selection ===
# RAG ingestion parser: pymupdf, llamaparse, liteparse
PDF_PARSER=pymupdf
# Chat file attachment parser: pymupdf, llamaparse, liteparse
CHAT_PDF_PARSER=pymupdf
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIER=agentic  # fast, cost_effective, agentic, agentic_plus
# LiteParse OCR -- empty url uses bundled Tesseract.js;
# point at e.g. http://easyocr:8000 or http://paddleocr:8000 for HTTP OCR.
LITEPARSE_OCR_SERVER_URL=
LITEPARSE_OCR_LANGUAGE=en
LITEPARSE_TIMEOUT_SECONDS=600
GROBID_URL=
GROBID_TIMEOUT_SECONDS=120

# Host ports (change when another stack already uses the defaults)
BACKEND_EXPOSE_PORT=8000
FRONTEND_EXPOSE_PORT=3000
FLOWER_EXPOSE_PORT=5555
MINIO_API_EXPOSE_PORT=9000
MINIO_CONSOLE_EXPOSE_PORT=9001
GROBID_EXPOSE_PORT=8070
# Production process/queue concurrency. Tune only after measuring this host.
BACKEND_WORKERS=4
RESEARCH_IO_CONCURRENCY=8
RESEARCH_LLM_CONCURRENCY=4

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === Sentry ===
SENTRY_DSN=

# === Prometheus ===
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_INCLUDE_IN_SCHEMA=false
# Required by production Compose; use a distinct random value and configure the
# same Bearer token in the internal Prometheus scrape job.
PROMETHEUS_AUTH_TOKEN=change-me-prometheus-auth-token
# Set automatically by docker-compose.prod.yml. Do not reuse one directory
# across containers; it is cleared before the Uvicorn master starts.
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc

# === S3/MinIO Storage ===
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=academic_research_agent
S3_REGION=us-east-1
# Required by docker-compose.prod.yml. Use a distinct, randomly generated
# password; it is also injected into the research object-store client.
MINIO_ROOT_USER=research-storage
MINIO_ROOT_PASSWORD=change-me-minio-root-password


# === AI Agent (pydantic_ai, OpenAI or DeepSeek) ===
OPENAI_API_KEY=
# Generative LLM provider: openai, deepseek, or openai_compatible. DeepSeek can
# use local research embeddings, so OPENAI_API_KEY may remain empty for it.
DEEPSEEK_API_KEY=
LLM_PROVIDER=openai
# Project-scoped third-party Responses-compatible endpoint. Never put this
# project's key in ~/.codex/auth.json when Codex should keep ChatGPT sign-in.
LLM_BASE_URL=
# Optional project-container-only DNS override. Use this only when the host's
# DNS intentionally blocks the configured gateway but a verified direct IP is
# available. It does not modify /etc/hosts or Codex configuration on the host.
LLM_GATEWAY_HOST=llm-gateway.invalid
LLM_GATEWAY_HOST_IP=127.0.0.1
AI_MODEL=gpt-5.5
AI_TEMPERATURE=0.7
AI_THINKING_ENABLED=false
AI_THINKING_EFFORT=medium  # low, medium, high

# === Web Search (Tavily) ===
# Get your API key at https://tavily.com
TAVILY_API_KEY=

# === Scholarly discovery ===
SCHOLARLY_USER_AGENT=academic_research_agent/0.1
CROSSREF_MAILTO=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SCHOLARLY_HTTP_TIMEOUT_SECONDS=30
SCHOLARLY_HTTP_MAX_RETRIES=3
# One Crossref keyword page is reduced to this many unique DOI seeds. OpenAlex
# then performs only free singleton DOI lookups; Unpaywall sees each DOI once.
RESEARCH_DISCOVERY_DOI_CANDIDATE_LIMIT=35

ENABLE_DEEP_RESEARCH=true
DEEP_RESEARCH_MAX_TOKENS=120000
DEEP_RESEARCH_COMPRESS_THRESHOLD=0.8

# === MCP Client (Settings → Integrations) ===
# Deployment-managed MCP servers, always attached on top of each user's own
# connections. JSON list; leave empty to rely purely on per-user connections.
# "name" is a slug (lowercase letters, digits, hyphens) and becomes the prefix
# of that server's tool names, so it must not clash with a name your users can
# pick in the marketplace — a clash means their connection is dropped in favour
# of this one. Startup fails on a malformed or duplicated name.
# MCP_SERVERS=[{"name":"github-internal","url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":"Bearer ghp_..."},"allowed_tools":["search_issues"]}]
MCP_SERVERS=[]
# Per-server budget for the pre-flight ping; unreachable servers are skipped.
MCP_CONNECT_TIMEOUT_SECS=3
# Embeddings; the research pipeline defaults to the independent local model.
EMBEDDING_MODEL=text-embedding-3-small
# Keep research retrieval local unless an official OpenAI embedding key is
# intentionally provisioned. This is independent from LLM_PROVIDER.
RESEARCH_EMBEDDING_PROVIDER=local
RESEARCH_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RESEARCH_LOCAL_EMBEDDING_DIM=384
LOCAL_PAPER_LIBRARY_ROOT=/local-paper-library
LOCAL_PAPER_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_PAPER_EMBEDDING_DIM=1024
# Internal Python model services; no OpenAI embedding endpoint/key is used.
LOCAL_PAPER_EMBEDDING_SERVICE_URL=http://bge-embedding:8001
LOCAL_PAPER_RERANKER_SERVICE_URL=http://bge-reranker:8002
LOCAL_PAPER_MODEL_HTTP_TIMEOUT_SECONDS=90
# Maximum number of child chunks sent in one local BGE-M3 embedding request.
LOCAL_PAPER_EMBEDDING_BATCH_SIZE=64
LOCAL_PAPER_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# A version bump forces structured parent-child re-ingestion.
LOCAL_PAPER_INGESTION_VERSION=structured-parent-child-bge-v3
RESEARCH_MAX_PAGES_PER_QUERY=20
RESEARCH_STALLED_AFTER_SECONDS=300
# Optional proxy used only by the host-network model-init service.
MODEL_DOWNLOAD_HTTP_PROXY=
# Optional HTTPS proxy reachable from Docker bridge containers. On Linux, a
# host proxy must listen beyond 127.0.0.1 before host.docker.internal can reach it.
RUNTIME_HTTPS_PROXY=
RUNTIME_NO_PROXY=localhost,127.0.0.1,db,redis,qdrant,minio,grobid,clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
PARSING_MIN_TEXT_COVERAGE=0.80
PARSING_MIN_TOTAL_CHARACTERS=500
PARSING_MIN_CAPTION_LINK_RATE=0.80
OCR_MIN_NATIVE_CHARACTERS=50
OCR_DPI=200
OCR_LANGUAGES=eng

# Chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Retrieval
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10

# Reranker

# PDF Parser
PDF_PARSER=pymupdf
CHAT_PDF_PARSER=pymupdf
LLAMAPARSE_API_KEY=

# Google Drive (optional, for document ingestion)

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === Docker Production (Traefik) ===
# Domain for production deployment
DOMAIN=example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
# Redis password for production. Keep it URL-safe (letters, digits, . _ ~ -)
# because Celery embeds it in its broker/result URLs.
REDIS_PASSWORD=change-me-in-production
# Flower monitoring credentials
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-in-production
